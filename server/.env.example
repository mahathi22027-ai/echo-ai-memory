# ECHO Backend Environment Configuration
# MongoDB Student Hackathon · PS1: Agentic Memory

# Server Port
PORT=5000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.petwe6h.mongodb.net/
MONGODB_DB_NAME=echo_journal

# Groq API Key (for fast LLM Chat & Autonomous Agentic Decisions)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (for 768-dim semantic embeddings)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
