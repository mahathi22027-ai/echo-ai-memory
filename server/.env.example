# ECHO Backend Environment Configuration
# MongoDB Student Hackathon · PS1: Agentic Memory

# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas cluster connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/echo_journal?retryWrites=true&w=majority
MONGODB_DB_NAME=echo_journal

# Groq API Key (for LLM Chat & Memory Extraction via llama-3.3-70b-versatile)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (for 1536-dim text-embedding-3-small embeddings)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
